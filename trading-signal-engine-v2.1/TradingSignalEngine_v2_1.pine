//@version=6
strategy("Trading Signal Engine V2.1 - Filtered", shorttitle="TSE V2.1", overlay=true, pyramiding=0, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, process_orders_on_close=true)

// Research/backtesting prototype. Score is rule alignment, NOT win probability.
// Initial target: XAUUSD 5-minute. Paper/backtest only.

emaFastLen = input.int(20, "EMA Fast", minval=1)
emaMidLen = input.int(50, "EMA Mid", minval=1)
emaSlowLen = input.int(200, "EMA Slow", minval=1)
rsiLen = input.int(14, "RSI Length", minval=2)
macdFast = input.int(12, "MACD Fast", minval=1)
macdSlow = input.int(26, "MACD Slow", minval=2)
macdSigLen = input.int(9, "MACD Signal", minval=1)
volLen = input.int(20, "Volume MA", minval=1)
atrLen = input.int(14, "ATR Length", minval=1)
structureLen = input.int(10, "Structure Lookback", minval=2)
sweepLen = input.int(10, "Liquidity Lookback", minval=2)
zoneLen = input.int(20, "Zone Lookback", minval=2)
htf = input.timeframe("15", "Higher Timeframe")
minScore = input.int(80, "Minimum Score", minval=50, maxval=100)
atrSLMult = input.float(1.5, "SL ATR Multiplier", minval=0.1, step=0.1)
rr = input.float(2.0, "Risk / Reward", minval=1.0, step=0.1)
minAtrRatio = input.float(0.70, "Minimum ATR / ATR-MA", minval=0.1, step=0.05)
maxExtension = input.float(1.8, "Max EMA20 Distance / ATR", minval=0.5, step=0.1)
minBodyRatio = input.float(0.45, "Minimum Candle Body / Range", minval=0.1, maxval=1.0, step=0.05)
cooldownBars = input.int(3, "Bars Between Entries", minval=0)
useSession = input.bool(false, "Use Session Filter")
sessionInput = input.session("0700-2000", "Allowed Session")

ema20 = ta.ema(close, emaFastLen)
ema50 = ta.ema(close, emaMidLen)
ema200 = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSigLen)
atr = ta.atr(atrLen)
atrMA = ta.sma(atr, 50)
volMA = ta.sma(volume, volLen)

htfClose = request.security(syminfo.tickerid, htf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfEMA20 = request.security(syminfo.tickerid, htf, ta.ema(close, emaFastLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfEMA50 = request.security(syminfo.tickerid, htf, ta.ema(close, emaMidLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfBull = htfClose > htfEMA20 and htfEMA20 > htfEMA50
htfBear = htfClose < htfEMA20 and htfEMA20 < htfEMA50

bullTrend = ema20 > ema50 and ema50 > ema200 and close > ema20
bearTrend = ema20 < ema50 and ema50 < ema200 and close < ema20

prevHigh = ta.highest(high, structureLen)[1]
prevLow = ta.lowest(low, structureLen)[1]
bullBreak = close > prevHigh
bearBreak = close < prevLow

priorSweepLow = ta.lowest(low, sweepLen)[1]
priorSweepHigh = ta.highest(high, sweepLen)[1]
lowSweep = low < priorSweepLow and close > priorSweepLow
highSweep = high > priorSweepHigh and close < priorSweepHigh

candleRange = math.max(high - low, syminfo.mintick)
bodySize = math.abs(close - open)
bodyRatio = bodySize / candleRange
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
bullReject = close > open and lowerWick / candleRange >= 0.35
bearReject = close < open and upperWick / candleRange >= 0.35
strongBullCandle = close > open and bodyRatio >= minBodyRatio
strongBearCandle = close < open and bodyRatio >= minBodyRatio

bullRSI = rsi > 50 and rsi < 70
bearRSI = rsi < 50 and rsi > 30
bullMACD = macdLine > macdSignal and macdHist > 0
bearMACD = macdLine < macdSignal and macdHist < 0

volumeAvailable = not na(volume) and not na(volMA)
relVolume = volumeAvailable ? volume / volMA : na
bullVolume = not volumeAvailable or relVolume >= 1.05
bearVolume = not volumeAvailable or relVolume >= 1.05

recentSupport = ta.lowest(low, zoneLen)[1]
recentResistance = ta.highest(high, zoneLen)[1]
nearSupport = low <= recentSupport + atr * 0.40 and close >= open
nearResistance = high >= recentResistance - atr * 0.40 and close <= open

volatilityOK = not na(atrMA) and atr >= atrMA * minAtrRatio
extension = atr > 0 ? math.abs(close - ema20) / atr : 999.0
notOverextended = extension <= maxExtension
sessionOK = not useSession or not na(time(timeframe.period, sessionInput))

// Avoid entering immediately after a large impulse candle.
impulseOK = bodyRatio <= 0.85 or lowSweep or highSweep

int buyScore = 0
buyScore += bullTrend ? 20 : 0
buyScore += htfBull ? 15 : 0
buyScore += (bullBreak or lowSweep) ? 15 : 0
buyScore += (bullRSI or bullMACD) ? 10 : 0
buyScore += bullMACD ? 10 : 0
buyScore += bullVolume ? 10 : 0
buyScore += (nearSupport or lowSweep) ? 10 : 0
buyScore += (bullReject or strongBullCandle) ? 5 : 0
buyScore += volatilityOK ? 3 : 0
buyScore += notOverextended ? 2 : 0

int sellScore = 0
sellScore += bearTrend ? 20 : 0
sellScore += htfBear ? 15 : 0
sellScore += (bearBreak or highSweep) ? 15 : 0
sellScore += (bearRSI or bearMACD) ? 10 : 0
sellScore += bearMACD ? 10 : 0
sellScore += bearVolume ? 10 : 0
sellScore += (nearResistance or highSweep) ? 10 : 0
sellScore += (bearReject or strongBearCandle) ? 5 : 0
sellScore += volatilityOK ? 3 : 0
sellScore += notOverextended ? 2 : 0

buyCore = bullTrend and htfBull and (bullRSI or bullMACD) and (bullBreak or lowSweep) and volatilityOK and notOverextended and sessionOK and impulseOK
sellCore = bearTrend and htfBear and (bearRSI or bearMACD) and (bearBreak or highSweep) and volatilityOK and notOverextended and sessionOK and impulseOK

var int lastEntryBar = na
canEnter = na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars
rawBuy = barstate.isconfirmed and canEnter and buyScore >= minScore and buyCore
rawSell = barstate.isconfirmed and canEnter and sellScore >= minScore and sellCore
buySignal = rawBuy and (not rawSell or buyScore > sellScore)
sellSignal = rawSell and (not rawBuy or sellScore > buyScore)

var float activeSL = na
var float activeTP = na
var string activeSide = ""

if buySignal and strategy.position_size <= 0
    activeSL := close - atr * atrSLMult
    activeTP := close + (close - activeSL) * rr
    activeSide := "BUY"
    lastEntryBar := bar_index
    strategy.entry("BUY", strategy.long, comment="BUY")

if sellSignal and strategy.position_size >= 0
    activeSL := close + atr * atrSLMult
    activeTP := close - (activeSL - close) * rr
    activeSide := "SELL"
    lastEntryBar := bar_index
    strategy.entry("SELL", strategy.short, comment="SELL")

if strategy.position_size > 0 and activeSide == "BUY"
    strategy.exit("BUY EXIT", from_entry="BUY", stop=activeSL, limit=activeTP)
if strategy.position_size < 0 and activeSide == "SELL"
    strategy.exit("SELL EXIT", from_entry="SELL", stop=activeSL, limit=activeTP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeSL := na
    activeTP := na
    activeSide := ""

plot(ema20, "EMA 20", color=color.new(color.blue, 0))
plot(ema50, "EMA 50", color=color.new(color.orange, 0))
plot(ema200, "EMA 200", color=color.new(color.purple, 0))
plot(strategy.position_size != 0 ? activeSL : na, "Active SL", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size != 0 ? activeTP : na, "Active TP", color=color.new(color.green, 0), style=plot.style_linebr)
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, text="BUY", color=color.new(color.green, 0), textcolor=color.white, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, text="SELL", color=color.new(color.red, 0), textcolor=color.white, size=size.small)

if buySignal
    alert("BUY | Score=" + str.tostring(buyScore) + " | Symbol=" + syminfo.ticker + " | TF=" + timeframe.period, alert.freq_once_per_bar_close)
if sellSignal
    alert("SELL | Score=" + str.tostring(sellScore) + " | Symbol=" + syminfo.ticker + " | TF=" + timeframe.period, alert.freq_once_per_bar_close)

var table dash = table.new(position.top_right, 2, 14, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "TSE V2.1", text_color=color.white)
    table.cell(dash, 1, 0, "FILTERED MODE", text_color=color.white)
    table.cell(dash, 0, 1, "BUY Score")
    table.cell(dash, 1, 1, str.tostring(buyScore))
    table.cell(dash, 0, 2, "SELL Score")
    table.cell(dash, 1, 2, str.tostring(sellScore))
    table.cell(dash, 0, 3, "HTF Trend")
    table.cell(dash, 1, 3, htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL")
    table.cell(dash, 0, 4, "Local Trend")
    table.cell(dash, 1, 4, bullTrend ? "BULLISH" : bearTrend ? "BEARISH" : "NEUTRAL")
    table.cell(dash, 0, 5, "RSI")
    table.cell(dash, 1, 5, str.tostring(rsi, "#.0"))
    table.cell(dash, 0, 6, "Rel Volume")
    table.cell(dash, 1, 6, na(relVolume) ? "N/A" : str.tostring(relVolume, "#.00"))
    table.cell(dash, 0, 7, "ATR Filter")
    table.cell(dash, 1, 7, volatilityOK ? "OK" : "LOW")
    table.cell(dash, 0, 8, "Extension")
    table.cell(dash, 1, 8, str.tostring(extension, "#.00"))
    table.cell(dash, 0, 9, "Session")
    table.cell(dash, 1, 9, sessionOK ? "OK" : "BLOCKED")
    table.cell(dash, 0, 10, "Signal")
    table.cell(dash, 1, 10, buySignal ? "BUY" : sellSignal ? "SELL" : "NO TRADE")
    table.cell(dash, 0, 11, "SL")
    table.cell(dash, 1, 11, na(activeSL) ? "-" : str.tostring(activeSL, "#.#####"))
    table.cell(dash, 0, 12, "TP")
    table.cell(dash, 1, 12, na(activeTP) ? "-" : str.tostring(activeTP, "#.#####"))
    table.cell(dash, 0, 13, "Mode")
    table.cell(dash, 1, 13, "BACKTEST / PAPER")
